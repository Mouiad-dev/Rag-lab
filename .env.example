# Placeholders only. Copy to .env and set your own values.
# The real .env is git-ignored and must never be committed.
POSTGRES_USER=rag_foundry
POSTGRES_DB=rag_foundry
POSTGRES_PASSWORD=change-me-local-only
API_HOST_PORT=8000
RAG_FOUNDRY_ENVIRONMENT=dev
RAG_FOUNDRY_LOG_LEVEL=INFO
# Local Ollama base URL (no credentials in the URL). Inside compose the worker uses http://ollama:11434 instead.
# RAG_FOUNDRY_OLLAMA_BASE_URL=http://127.0.0.1:11434
