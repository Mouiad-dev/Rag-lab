{
  "schema_version": 1,
  "note": "Loadable example for load_providers_config (P2.4-02). Secrets are never stored here: api_key_env names an environment variable. Rates are USD per million tokens as JSON strings (ADR-0001, Verified 2026-11-02). anthropic-haiku uses the flat rates valid up to 100,000 prompt tokens; above that the adapter returns cost None. vLLM uses port 8001 on purpose: 8000 is the RAG Foundry API port. lmstudio, vllm and moonshot are endpoints only until a model is chosen (moonshot has one profile); no stage is bound to them by default. Alternatives: docs/plan/FREE_MODELS.md.",
  "endpoints": [
    {"id": "fake", "adapter": "fake", "local": true},
    {"id": "ollama", "adapter": "ollama", "base_url": "http://127.0.0.1:11434", "local": true},
    {"id": "anthropic", "adapter": "anthropic", "api_key_env": "ANTHROPIC_API_KEY", "local": false},
    {"id": "lmstudio", "adapter": "openai_compatible", "base_url": "http://localhost:1234/v1", "local": true, "max_tokens_field": "max_tokens"},
    {"id": "vllm", "adapter": "openai_compatible", "base_url": "http://127.0.0.1:8001/v1", "local": true},
    {"id": "moonshot", "adapter": "openai_compatible", "base_url": "https://api.moonshot.ai/v1", "api_key_env": "MOONSHOT_API_KEY", "local": false,
     "max_tokens_field": "max_completion_tokens", "supports_temperature": false, "default_max_tokens": 4096}
  ],
  "profiles": [
    {"id": "fake-chat", "provider": "fake", "model": "fake-chat", "kind": "chat",
     "capabilities": {"streaming": true, "local": true}},
    {"id": "local-chat", "provider": "ollama", "model": "gemma4:e4b", "kind": "chat",
     "capabilities": {"streaming": true, "local": true}},
    {"id": "local-embed", "provider": "ollama", "model": "bge-m3", "kind": "embedding",
     "capabilities": {"embedding_dim": 1024, "token_embeddings": false, "multivector": false, "local": true}},
    {"id": "anthropic-haiku", "provider": "anthropic", "model": "claude-haiku-5-5", "kind": "chat",
     "capabilities": {"streaming": true, "context_window": 1000000, "max_output_tokens": 128000},
     "cost_per_mtok_in": "0.10", "cost_per_mtok_out": "0.50",
     "cost_per_mtok_cache_read": "0.01", "cost_per_mtok_cache_write": "0.125"},
    {"id": "kimi-k3-1-pro", "provider": "moonshot", "model": "kimi-k3.1-pro", "kind": "chat",
     "capabilities": {"streaming": true, "context_window": 1048576},
     "cost_per_mtok_in": "2.00", "cost_per_mtok_out": "10.00",
     "cost_per_mtok_cache_read": "0.20", "cost_per_mtok_cache_write": "2.00"}
  ],
  "stages": {
    "generator": "local-chat",
    "query_transform": "local-chat",
    "judge": "local-chat",
    "embedder": "local-embed"
  }
}
