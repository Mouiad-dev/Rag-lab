{
  "_note": "Illustrative design contract for ADR-0001, not an executable config yet. Secrets are never stored here: api_key_env names an environment variable. Model IDs and costs must be verified against provider docs before use. Local defaults (gemma4:e4b, bge-m3) chosen 2026-10-26 for low RAM + Arabic/English; re-benchmark at P2.2. Alternatives: docs/plan/FREE_MODELS.md.",
  "schema_version": 1,
  "providers": [
    {"id": "ollama", "adapter": "litellm", "base_url": "http://localhost:11434", "api_key_env": null, "local": true},
    {"id": "lmstudio", "adapter": "litellm_openai_compatible", "base_url": "http://localhost:1234/v1", "api_key_env": null, "local": true},
    {"id": "vllm", "adapter": "litellm_openai_compatible", "base_url": "http://localhost:8000/v1", "api_key_env": null, "local": true},
    {"id": "anthropic", "adapter": "litellm", "api_key_env": "ANTHROPIC_API_KEY", "local": false},
    {"id": "openai", "adapter": "litellm", "api_key_env": "OPENAI_API_KEY", "local": false},
    {"id": "google", "adapter": "litellm", "api_key_env": "GEMINI_API_KEY", "local": false},
    {"id": "mistral", "adapter": "litellm", "api_key_env": "MISTRAL_API_KEY", "local": false},
    {"id": "moonshot", "adapter": "litellm_openai_compatible", "base_url": "TO_BE_VERIFIED", "api_key_env": "MOONSHOT_API_KEY", "local": false}
  ],
  "model_profiles": [
    {"id": "local-chat", "provider": "ollama", "model": "gemma4:e4b", "kind": "chat",
     "capabilities": {"tool_calling": false, "structured_output": true, "vision": false, "streaming": true, "context_window": null}},
    {"id": "local-embed", "provider": "ollama", "model": "bge-m3", "kind": "embedding",
     "capabilities": {"embedding_dim": 1024, "token_embeddings": false, "multivector": false}},
    {"id": "claude-opus", "provider": "anthropic", "model": "claude-opus-5-5", "kind": "chat",
     "capabilities": {"tool_calling": true, "structured_output": true, "vision": true, "streaming": true, "context_window": null},
     "cost_per_mtok_in": null, "cost_per_mtok_out": null},
    {"id": "claude-sonnet", "provider": "anthropic", "model": "claude-sonnet-5-5", "kind": "chat",
     "capabilities": {"tool_calling": true, "structured_output": true, "vision": true, "streaming": true, "context_window": null},
     "cost_per_mtok_in": null, "cost_per_mtok_out": null},
    {"id": "kimi", "provider": "moonshot", "model": "TO_BE_VERIFIED_KIMI_K_SERIES", "kind": "chat",
     "capabilities": {"tool_calling": null, "structured_output": null, "streaming": true, "context_window": null}}
  ],
  "pipeline_defaults": {
    "generator": "local-chat",
    "embedder": "local-embed",
    "reranker": null,
    "query_transform": "local-chat",
    "judge": "local-chat",
    "scout": "claude-opus"
  }
}
